# Variaveis usadas pelo docker-compose.yml (infraestrutura)
# Copie este arquivo para ".env" antes de subir os containers.

# Portas expostas no host
NGINX_PORT=8000
FRONTEND_PORT=5173
MYSQL_PORT=3306

# Credenciais do MySQL (devem bater com backend/.env)
MYSQL_DATABASE=clientes_cep
MYSQL_USER=laravel
MYSQL_PASSWORD=laravel
MYSQL_ROOT_PASSWORD=root
